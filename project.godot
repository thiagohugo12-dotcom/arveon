; Godot project configuration; open this file with Godot 4.5.1.
config_version=5

[application]
config/name="Grande Árvore RPG — v0.5.0 — O Chamado da Torre"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194321)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194323)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
dash={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325),Object(InputEventKey,"physical_keycode":32)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
skill_1={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
skill_2={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
ultimate={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51)]}
character={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}

[input_devices]
pointing/emulate_mouse_from_touch=false

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.065, 0.11, 0.085, 1)

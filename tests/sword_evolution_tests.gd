extends RefCounted

static func run(suite: SceneTree) -> void:
	var p := GameProgress.new()
	p.xp = RPGRules.xp_floor(100)
	suite.check(TalentRules.MAX_PROFICIENCY == 60, "proficiency 60 is defined centrally")
	suite.check(AbilityRules.available("espada","ruptura_ancestral",40) and not AbilityRules.available("espada","ruptura_ancestral",39), "Sword Ruptura Ancestral unlock gate is level 40")
	p.talents.xp.espada = TalentRules.xp_floor(39)
	suite.check(not p.configure_ability("equip_skill","espada","ruptura_ancestral",0,true), "locked sword technique cannot be forced into loadout")
	p.talents.xp.espada = TalentRules.xp_floor(40)
	suite.check(p.configure_ability("equip_skill","espada","ruptura_ancestral",0,true), "Sword level 40 technique can be equipped at camp")
	suite.check(AbilityRules.effect("ruptura_ancestral").shape == "line" and AbilityRules.effect("ruptura_ancestral").width == 40.0, "new sword technique has a real combat shape")
	p.talents.xp.espada = TalentRules.xp_floor(34)
	suite.check(not p.configure_ability("equip_passive","espada","instinto_veterano",0,true), "level 35 passive cannot be equipped early")
	p.talents.xp.espada = TalentRules.xp_floor(35)
	suite.check(p.configure_ability("equip_passive","espada","instinto_veterano",0,true), "sword veteran passive unlocks at 35")
	p.talents.xp.espada = TalentRules.xp_floor(49)
	suite.check(not p.configure_ability("equip_passive","espada","vontade_ancestral",1,true), "level 50 passive cannot be equipped early")
	p.talents.xp.espada = TalentRules.xp_floor(50)
	suite.check(p.configure_ability("equip_passive","espada","vontade_ancestral",1,true), "level 50 sword passive equips in the second passive slot")
	p.talents.xp.espada = TalentRules.xp_floor(55)
	suite.check(not p.learn_talent("espada","bastiao_ancestral",true), "late defensive talent requires an actual parent purchase")
	suite.check(p.learn_talent("espada","guarda_aperfeicoada",true) and p.learn_talent("espada","postura_equilibrada",true) and p.learn_talent("espada","bastiao_ancestral",true), "sword defensive path learns in prerequisite order")
	p.talents.xp.espada = TalentRules.xp_floor(60)
	var cap: int = p.talents.xp.espada
	suite.check(p.talents.level("espada") == 60 and not p.talents.record_damage("espada",99999) and p.talents.xp.espada == cap, "level 60 is a hard XP cap")
	suite.check(is_equal_approx(p.talents.mastery_bonuses("espada").automatic,0.295), "all sixty levels apply deterministic automatic proficiency scaling")
	var saved := p.to_json()
	var restored := GameProgress.new()
	suite.check(restored.load_text(saved) and restored.to_json() == saved and restored.talents.level("espada") == 60, "v11 saves round-trip unchanged with expanded proficiency")
	var old := GameProgress.new()
	old.talents.xp.espada = TalentRules.xp_floor(30)
	var old_json := old.to_json()
	var old_reload := GameProgress.new()
	suite.check(old_reload.load_text(old_json) and old_reload.talents.level("espada") == 30, "old v11 proficiency 30 save remains loadable")
	var tree := SwordEvolutionTree.new(restored)
	suite.root.add_child(tree)
	suite.check(tree.buttons.has("normal:ruptura_ancestral") and tree.buttons.has("supreme:ascensao_lamina") and tree.buttons.has("talent:bastiao_ancestral"), "new pixel diary includes late-sword nodes")
	suite.check(tree.buttons["supreme:ascensao_lamina"].custom_minimum_size.y >= 44, "sword tree milestone buttons use mobile touch targets")
	tree.queue_free()
